{
  "name": "edge-gateway",
  "version": "1.0.0",
  "description": "Ultra-lightweight Cloudflare Worker Edge Gateway with Traffic Steering and JWT Guard",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run deploy:all",
    "deploy:auth": "bash .github/scripts/deploy_boundary.sh auth",
    "deploy:admin": "bash .github/scripts/deploy_boundary.sh admin",
    "deploy:core": "bash .github/scripts/deploy_boundary.sh core",
    "deploy:all": "npm run deploy:auth && npm run deploy:admin && npm run deploy:core",
    "test": "vitest run && bash test/deploy_boundary_contract.sh",
    "typecheck": "tsc --noEmit",
    "check:bundle-size": "bash scripts/check_bundle_size.sh"
  },
  "keywords": [
    "cloudflare-worker",
    "api-gateway",
    "failover",
    "edge-auth",
    "traffic-steering"
  ],
  "author": "AI Workspace Team",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240208.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2",
    "wrangler": "^3.28.0"
  }
}
